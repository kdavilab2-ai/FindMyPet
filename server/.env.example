# El instalador de Windows prepara server/.env. En un despliegue manual completa las variables.

# Base de datos PostgreSQL (local o Neon/Supabase). En la nube agregar ?sslmode=require
DATABASE_URL=
# Base de datos separada para las pruebas (npm test la borra y la vuelve a crear)
TEST_DATABASE_URL=

# Texto largo y aleatorio para firmar las sesiones (JWT)
JWT_SECRET=
PORT=4000

# Dirección del frontend: se usa en el enlace de recuperación de contraseña y en CORS
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# IA (opcional): clave gratuita en https://aistudio.google.com/apikey
# Sin clave, las coincidencias se calculan solo por atributos y no se validan las fotos.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Correo para recuperar contraseña. En desarrollo sin SMTP, el enlace se muestra en la consola.
# En producción se requiere SMTP con TLS. Render Free admite un relay que ofrezca STARTTLS en 2525.
# Ejemplo con Gmail: crear una "contraseña de aplicación" en la cuenta de Google.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FindMyPet <tu-correo@gmail.com>"
